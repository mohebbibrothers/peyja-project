# ── BoxAPI / Sendbox (خط ① رسمی — DM/Comment) ────────────────────────────────
BOXAPI_API_KEY=your-api-key
BOXAPI_LOGIN_TOKEN=your-login-token
BOXAPI_BASE_URL=https://api.sendbox.chat/api/v1
BOXAPI_LOGIN_URL=https://api.sendbox.chat
BOXAPI_DOMAIN=https://your-domain.example
APP_URL=https://your-domain.example
DEMO_MODE=false
ENABLE_TEST_PAGE=true

# ── وب‌هوک ────────────────────────────────────────────────────────────────────
BOXAPI_WEBHOOK_SECRET=whsec_your-webhook-secret

# ── خط ② دیتای عمومی (توکن جدا — طرح ۱۴ روزه‌ی boxapi.ir) ─────────────────────
BOXAPI_DATA_TOKEN=

# ── خط ③ AI ───────────────────────────────────────────────────────────────────
BOXAPI_AI_TOKEN=

# ── ذخیره‌سازی (خالی ← SQLite از DB_PATH) ─────────────────────────────────────
DATABASE_URL=
DB_PATH=./data/app.db
MEDIA_DIR=./data/media

# ── استخراج ───────────────────────────────────────────────────────────────────
EXTRACT_VLM_MODEL=gpt-4o-mini
EXTRACT_CONFIDENCE_TAU=0.75
CRAWL_MAX_REQUESTS=300

# ── موتور پاسخ خودکار (P0) — خالی = غیرفعال ──
AUTO_REPLY_TEXT=سلام! 🌸 پیام شما ثبت شد؛ به‌زودی پاسخ می‌دهیم.
